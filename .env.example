# ---------------------------------------------------------------------------
#  LunaGC local-development environment overrides.
#
#  Copy this file to .env and fill in the values for this machine.
#  Optional .env.local overrides .env; both files are gitignored.
# ---------------------------------------------------------------------------

# Directory that contains YuanShen.exe -- the parent of YuanShen_Data.
#
# Leave empty to auto-detect from the miHoYo launcher registry
# (HKCU:\Software\miHoYo\HYP\1_1\hk4e_cn, GameInstallPath). Auto-detect is the
# right choice for almost everyone; only set this if the client lives outside
# the launcher (a standalone install, a second client version, a test box with
# no launcher at all).
GAME_PATH=

# Use a separate LunaGC-Resources checkout for local development. When unset,
# the server uses the resources/ Git submodule next to the jar.
# LUNAGC_RESOURCES_DIR=D:/Projects/Experiment/LunaGC-Resources

# Address advertised to game clients by the Docker Compose runtime. Set this
# to the remote machine's public IP or DNS name when clients connect remotely.
# LUNAGC_PUBLIC_ADDRESS=game.example.com

# Local-only Compose HTTP shortcut for http://localhost/gm (8088 remains available).
# LUNAGC_GM_HTTP_PORT=80

# Name of the server jar that `task build:jar` produces and `task serve` runs.
# Override only if you changed jarFilename in build.gradle.
# LUNAGC_JAR=LunaGC-7.1.0.jar

# Development and runtime share Compose's persistent MongoDB by default.
# `task serve` starts only the Compose mongo service; the runtime server remains
# stopped during a local development session. MongoDB is published on loopback.
# LUNAGC_MONGO_PORT=27017
# LUNAGC_MONGO_URI=mongodb://127.0.0.1:27017
# To use a separate existing MongoDB container instead, set BOTH its name and URI.
# LUNAGC_MONGO=my-separate-mongo
# LUNAGC_MONGO_URI=mongodb://127.0.0.1:27018

# Ports the server binds. Change these together with config.json
# (server.httpBindPort / server.gameServerBindPort) or the client will not
# reach the server.
# LUNAGC_HTTP_PORT=8088
# LUNAGC_GAME_PORT=22101
